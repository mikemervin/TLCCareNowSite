# Canonical site URL for sitemap, Open Graph, and SEO (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://www.tlccarenow.com

# Analytics "Today" and timeline times (IANA name). Default: America/New_York (Eastern)
# SITE_TIMEZONE=America/New_York

# Google Analytics 4 (optional in dev; set in Vercel for production)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-1MWHB7YYCV

# After deploy: add property at https://search.google.com/search-console
# Prefer the www property and submit https://www.tlccarenow.com/sitemap.xml
# Apex (tlccarenow.com) permanently redirects to www via next.config.ts.

# First-party analytics (your own data)
NEXT_PUBLIC_ANALYTICS_ENABLED=true
# ANALYTICS_ADMIN_SECRET=long-random-secret-min-16-chars
# Local dev: events saved to data/analytics-events.jsonl
#
# Production (recommended): connect Postgres via Vercel Storage (Neon or Supabase).
# Supabase sets POSTGRES_URL, POSTGRES_URL_NON_POOLING, etc. automatically.
# Analytics uses POSTGRES_URL only — no Supabase JS keys required for the dashboard.
#
# Legacy Blob storage (Hobby limit: 2k advanced ops/month — easy to exceed):
# ANALYTICS_USE_BLOB=false   # required after moving to Postgres, or while Blob is blocked

# Contact form (Resend) — https://resend.com
# Create an API key, then verify your sending domain (e.g. teamlifecares.com).
RESEND_API_KEY=re_your_api_key_here

# Where form submissions are delivered (defaults to info@teamlifecares.com)
CONTACT_TO_EMAIL=info@teamlifecares.com

# Sender — use onboarding@resend.dev until teamlifecares.com is Verified in Resend
# Production (after domain verify): TLC CareNow <noreply@teamlifecares.com>
CONTACT_FROM_EMAIL=TLC CareNow <onboarding@resend.dev>
